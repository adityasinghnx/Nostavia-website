{
  "redirects": [
    {
      "source": "/superintelligence",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/modules",
      "destination": "/human-os",
      "statusCode": 301
    },
    {
      "source": "/modules/:path*",
      "destination": "/human-os",
      "statusCode": 301
    },
    {
      "source": "/intelligence-modules",
      "destination": "/human-os",
      "statusCode": 301
    },
    {
      "source": "/platform/modules",
      "destination": "/human-os",
      "statusCode": 301
    },
    {
      "source": "/industries/:path*",
      "destination": "/customers",
      "statusCode": 301
    },
    {
      "source": "/solutions/engineering",
      "destination": "/studio",
      "statusCode": 301
    },
    {
      "source": "/solutions/supplements",
      "destination": "/studio",
      "statusCode": 301
    },
    {
      "source": "/solutions/gravity",
      "destination": "/developers",
      "statusCode": 301
    },
    {
      "source": "/solutions/hospitals",
      "destination": "/customers",
      "statusCode": 301
    },
    {
      "source": "/solutions/hospitals-front-door",
      "destination": "/customers",
      "statusCode": 301
    },
    {
      "source": "/pricing",
      "destination": "/demo",
      "statusCode": 301
    },
    {
      "source": "/platform",
      "destination": "/",
      "statusCode": 301
    },
    {
      "source": "/human-os/:path+",
      "destination": "/human-os",
      "statusCode": 301
    },
    {
      "source": "/company",
      "destination": "/about",
      "statusCode": 301
    },
    {
      "source": "/security",
      "destination": "/trust",
      "statusCode": 301
    },
    {
      "source": "/clinical",
      "destination": "/trust#clinical",
      "statusCode": 301
    },
    {
      "source": "/solutions/front-desk",
      "destination": "/hive",
      "statusCode": 301
    },
    {
      "source": "/solutions/ai-agents",
      "destination": "/hive",
      "statusCode": 301
    },
    {
      "source": "/solutions/voice-agents",
      "destination": "/hive",
      "statusCode": 301
    },
    {
      "source": "/solutions/:path*",
      "destination": "/human-os",
      "statusCode": 301
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.vcf",
      "headers": [
        { "key": "Content-Type", "value": "text/vcard; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
